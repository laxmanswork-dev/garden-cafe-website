# Cloudflare Pages response headers (https://developers.cloudflare.com/pages/configuration/headers/).
# HTML is left to the Pages default (always revalidated), so a new deploy reaches visitors at once.

# Scripts and styles carry a content hash in their file name: a changed file is a new URL.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Fonts are fixed files that never change under the same name.
/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# Photographs and videos keep their names when the cafe replaces them, so they are
# cached for a day only, then quietly refreshed in the background for up to a week.
/images/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
